# Port the API server listens on
PORT=4001

# Secret used to sign admin JWT sessions — change this to a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API (your site's dev/prod URLs)
CORS_ORIGIN=http://localhost:5199,http://localhost:5173

# Used only by `npm run seed-admin` to create/update the admin account.
# Not read at server runtime — safe to remove after seeding.
ADMIN_EMAIL=admin@oknok.africa
ADMIN_PASSWORD=change-me-please
